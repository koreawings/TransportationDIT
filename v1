                                <i class="fa-solid ${iconClass} text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center flex-wrap gap-1">
                                    <span class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
                                        #${index + 1}
                                    </span>
                                    <span class="text-[10px] font-extrabold px-1.5 py-0.5 rounded ${isBestScore ? 'bg-violet-600 text-white' : 'bg-violet-100 dark:bg-violet-950 text-violet-700 dark:text-violet-300'} flex items-center">
                                        <i class="fa-solid fa-star text-[8px] mr-1"></i>추천 ${item.smartScore}점
                                    </span>
                                    ${isFastest ? `<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300"><i class="fa-solid fa-bolt text-[9px] mr-0.5"></i>시간 1위</span>` : ''}
                                    ${isCheapest ? `<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300"><i class="fa-solid fa-won-sign text-[9px] mr-0.5"></i>비용 1위</span>` : ''}
                                </div>
                                <h3 class="font-extrabold text-slate-900 dark:text-white text-sm sm:text-base mt-1 break-keep leading-tight">
                                    ${escapeHtml(item.name)}
                                </h3>
                            </div>
                        </div>

                        <!-- 7단계: 수정(연필) & 삭제(휴지통) 버튼 -->
                        <div class="flex items-center space-x-1 shrink-0">
                            <button onclick="startEditRoute('${item.id}')" 
                                class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-slate-700 active:scale-95 rounded-xl transition" 
                                aria-label="이 통학 방법 수정"
                                title="수정하기">
                                <i class="fa-solid fa-pen-to-square text-xs"></i>
                            </button>
                            <button onclick="promptDeleteRoute('${item.id}', '${escapeHtml(item.name)}')" 
                                class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-slate-700 active:scale-95 rounded-xl transition" 
                                aria-label="이 통학 방법 삭제"
                                title="삭제하기">
                                <i class="fa-regular fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- 7단계 & 8단계: 피로도 배지, 도보 시간, 날씨 페널티 표시 -->
                    <div class="flex items-center flex-wrap gap-1.5 text-[11px]">
                        <span class="px-2 py-0.5 rounded-lg font-bold ${fMeta.badgeClass} flex items-center space-x-1">
                            <span>${fMeta.emoji}</span>
                            <span>피로도 Lv.${item.effectiveFatigue} (${fMeta.label})</span>
                        </span>
                        <span class="px-2 py-0.5 rounded-lg font-semibold bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-slate-300 flex items-center space-x-1">
                            <i class="fa-solid fa-person-walking text-[10px] text-slate-400"></i>
                            <span>도보 ${item.walkMinutes}분</span>
                        </span>
                        ${item.weatherPenaltyApplied ? `
                            <span class="px-2 py-0.5 rounded-lg font-bold bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 flex items-center space-x-1">
                                <span>☔ 우천 시 취약</span>
                            </span>
                        ` : ''}
                    </div>

                    <!-- Single Trip Specs -->
                    <div class="grid grid-cols-3 gap-1.5 bg-slate-50/90 dark:bg-slate-900/60 p-2 sm:p-2.5 rounded-xl text-center border border-slate-100 dark:border-slate-700/60">
                        <div class="px-1">
                            <span class="block text-[10px] text-slate-400 font-medium">편도 시간</span>
                            <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100">${item.oneWayMinutes}분</span>
                        </div>
                        <div class="border-x border-slate-200 dark:border-slate-700 px-1">
                            <span class="block text-[10px] text-slate-400 font-medium">편도 기본요금</span>
                            <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 break-keep">${Number(item.oneWayCost).toLocaleString()}원</span>
                        </div>
                        <div class="px-1">
                            <span class="block text-[10px] text-slate-400 font-medium">환승</span>
                            <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100">${item.transfers === 0 ? '직통(0회)' : item.transfers + '회'}</span>
                        </div>
                    </div>

                    <!-- 6단계: 한 달 총 소요시간 & 교통패스 할인 반영 총 교통비 (취소선 포함) -->
                    <div class="bg-indigo-50/70 dark:bg-indigo-950/40 rounded-xl p-2.5 sm:p-3 border border-indigo-100/90 dark:border-indigo-900/70 flex flex-wrap items-center justify-between gap-2">
                        <div class="min-w-[115px]">
                            <span class="text-[10px] font-semibold text-indigo-700 dark:text-indigo-300 block break-keep">한 달 총 시간 (왕복 ${schoolDays}일)</span>
                            <span class="text-xs sm:text-sm font-black text-indigo-950 dark:text-white">${formatMinutes(monthlyTotalMinutes)}</span>
                        </div>
                        <div class="text-right ml-auto">
                            <div class="flex items-center justify-end space-x-1">
                                ${badgeNote ? `<span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-white/80 dark:bg-slate-800 text-indigo-600 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800">${badgeNote}</span>` : ''}
                                <span class="text-[10px] font-semibold text-indigo-700 dark:text-indigo-300">한 달 실교통비</span>
                            </div>
                            <div class="flex items-baseline justify-end space-x-1.5 mt-0.5">
                                ${discountApplied ? `<span class="text-[11px] text-slate-400 line-through font-medium">${rawMonthlyCost.toLocaleString()}원</span>` : ''}
                                <span class="text-xs sm:text-sm font-black ${discountApplied ? 'text-emerald-600 dark:text-emerald-400' : 'text-indigo-700 dark:text-indigo-300'}">${finalCost.toLocaleString()}원</span>
                            </div>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function renderAnalyticsView() {
            const daysLabel = document.getElementById('analyticsDaysLabel');
            const passLabel = document.getElementById('analyticsPassLabel');
            if (daysLabel) daysLabel.textContent = `${schoolDays}일`;

            const passNames = { 'NONE': '패스 미적용', 'KPASS': 'K-패스 청년 30%', 'CLIMATE': '기후동행 청년권' };
            if (passLabel) passLabel.textContent = passNames[passType] || '패스 미적용';

            const compContainer = document.getElementById('analyticsComparisonContent');
            const statAvgMin = document.getElementById('statAvgMinutes');
            const statAvgCost = document.getElementById('statAvgCost');
            const statAvgFatigue = document.getElementById('statAvgFatigue');

            const enriched = computeEnrichedRoutes();

            if (enriched.length === 0) {
                compContainer.innerHTML = '<p class="text-slate-300 text-center py-3">분석할 통학 데이터가 없습니다.</p>';
                statAvgMin.textContent = '-';
                statAvgCost.textContent = '-';
                statAvgFatigue.textContent = '-';
                return;
            }

            const fastest = [...enriched].sort((a, b) => a.oneWayMinutes - b.oneWayMinutes)[0];
            const cheapest = [...enriched].sort((a, b) => a.costInfo.finalCost - b.costInfo.finalCost)[0];

            const fastestMonthlyMin = fastest.oneWayMinutes * 2 * schoolDays;
            const cheapestMonthlyMin = cheapest.oneWayMinutes * 2 * schoolDays;

            const fastestMonthlyCost = fastest.costInfo.finalCost;
            const cheapestMonthlyCost = cheapest.costInfo.finalCost;

            const savedMinutes = Math.max(0, cheapestMonthlyMin - fastestMonthlyMin);
            const extraCostForFastest = Math.max(0, fastestMonthlyCost - cheapestMonthlyCost);

            // 6단계: 최저시급(10,030원) 기준 시간의 화폐 가치(기회비용) 계산
            const savedHoursFloat = savedMinutes / 60;
            const timeMonetaryValue = Math.round(savedHoursFloat * MINIMUM_WAGE_KRW);
            const netBenefit = timeMonetaryValue - extraCostForFastest;

            let opportunityComment = '';
            if (fastest.id === cheapest.id) {
                opportunityComment = `🎉 <strong>${escapeHtml(fastest.name)}</strong> 경로가 시간과 비용 모두 1위입니다! 고민 없이 이 경로를 선택하세요.`;
            } else if (netBenefit >= 0) {
                opportunityComment = `💰 <strong>시간을 돈으로 산다면 이득!</strong> 가장 빠른 경로로 아낀 한 달 시간(<strong>${formatMinutes(savedMinutes)}</strong>)을 최저시급으로 환산하면 약 <strong>${timeMonetaryValue.toLocaleString()}원</strong>의 가치가 있습니다. 추가 교통비(${extraCostForFastest.toLocaleString()}원)보다 시간 가치가 <strong>${netBenefit.toLocaleString()}원 더 높으므로</strong> 빠른 경로를 적극 추천합니다.`;
            } else {
                opportunityComment = `⚖️ <strong>가성비(비용 절약) 우세!</strong> 빠른 경로로 아끼는 시간의 시급 환산 가치(약 <strong>${timeMonetaryValue.toLocaleString()}원</strong>)보다 추가 교통비 부담(<strong>${extraCostForFastest.toLocaleString()}원</strong>)이 더 큽니다. 여유 있는 날엔 저렴한 경로로 생활비를 아껴보세요.`;
            }

            compContainer.innerHTML = `
                <div class="grid grid-cols-2 gap-2 text-center bg-white/10 p-2.5 rounded-xl">
                    <div class="border-r border-white/10 pr-2">
                        <span class="text-[10px] text-amber-300 font-bold block">⚡ 시간 1위 경로</span>
                        <p class="font-bold text-xs truncate mt-0.5">${escapeHtml(fastest.name)}</p>
                        <p class="text-[11px] text-slate-200 mt-1">${formatMinutes(fastestMonthlyMin)} / ${fastestMonthlyCost.toLocaleString()}원</p>
                    </div>
                    <div class="pl-2">
                        <span class="text-[10px] text-emerald-300 font-bold block">🐷 비용 1위 경로</span>
                        <p class="font-bold text-xs truncate mt-0.5">${escapeHtml(cheapest.name)}</p>
                        <p class="text-[11px] text-slate-200 mt-1">${formatMinutes(cheapestMonthlyMin)} / ${cheapestMonthlyCost.toLocaleString()}원</p>
                    </div>
                </div>
                <div class="bg-indigo-950/80 p-3 rounded-xl border border-indigo-400/30 text-indigo-100 text-[11px] leading-relaxed break-keep space-y-1">
                    <div class="font-bold text-amber-300 flex items-center">
                        <i class="fa-solid fa-coins mr-1.5"></i>시간의 화폐 가치 (기회비용 분석)
                    </div>
                    <p>${opportunityComment}</p>
                </div>
            `;

            const sumMinutes = enriched.reduce((acc, r) => acc + r.oneWayMinutes, 0);
            const sumMonthlyCost = enriched.reduce((acc, r) => acc + r.costInfo.finalCost, 0);
            const sumFatigue = enriched.reduce((acc, r) => acc + r.effectiveFatigue, 0);

            statAvgMin.textContent = `${Math.round(sumMinutes / enriched.length)}분`;
            statAvgCost.textContent = `${Math.round(sumMonthlyCost / enriched.length).toLocaleString()}원`;
            statAvgFatigue.textContent = `Lv.${(sumFatigue / enriched.length).toFixed(1)}`;
        }

        // 9단계: Chart.js 차트 2종 렌더링 (안전하게 기존 인스턴스 destroy 후 재생성)
        function renderAnalyticsCharts() {
            const barCanvas = document.getElementById('barChartCanvas');
            const radarCanvas = document.getElementById('radarChartCanvas');
            if (!barCanvas || !radarCanvas || typeof Chart === 'undefined') return;

            if (barChartInstance) {
                barChartInstance.destroy();
                barChartInstance = null;
            }
            if (radarChartInstance) {
                radarChartInstance.destroy();
                radarChartInstance = null;
            }

            const enriched = computeEnrichedRoutes();
            if (enriched.length === 0) return;

            const isDark = document.documentElement.classList.contains('dark');
            const textColor = isDark ? '#cbd5e1' : '#475569';
            const gridColor = isDark ? 'rgba(148, 163, 184, 0.15)' : 'rgba(148, 163, 184, 0.25)';

            // 1. Dual-axis Bar Chart (Monthly Hours vs Monthly Cost in 10,000 KRW)
            const labels = enriched.map(r => r.name.length > 8 ? r.name.slice(0, 8) + '…' : r.name);
            const monthlyHoursData = enriched.map(r => Number(((r.oneWayMinutes * 2 * schoolDays) / 60).toFixed(1)));
            const monthlyCostManwonData = enriched.map(r => Number((r.costInfo.finalCost / 10000).toFixed(2)));

            barChartInstance = new Chart(barCanvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        {
                            label: '월 소요시간 (시간)',
                            data: monthlyHoursData,
                            backgroundColor: 'rgba(99, 102, 241, 0.8)',
                            borderColor: 'rgb(99, 102, 241)',
                            borderWidth: 1,
                            borderRadius: 6,
                            yAxisID: 'yTime'
                        },
                        {
                            label: '월 실교통비 (만원)',
                            data: monthlyCostManwonData,
                            backgroundColor: 'rgba(16, 185, 129, 0.8)',
                            borderColor: 'rgb(16, 185, 129)',
                            borderWidth: 1,
                            borderRadius: 6,
                            yAxisID: 'yCost'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: {
                            labels: { color: textColor, font: { family: 'Noto Sans KR', size: 11 } }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: textColor, font: { family: 'Noto Sans KR', size: 10 } },
                            grid: { display: false }
                        },
                        yTime: {
                            type: 'linear',
                            position: 'left',
                            title: { display: true, text: '시간 (h)', color: textColor, font: { size: 10 } },
                            ticks: { color: textColor, font: { size: 10 } },
                            grid: { color: gridColor }
                        },
                        yCost: {
                            type: 'linear',
                            position: 'right',
                            title: { display: true, text: '비용 (만원)', color: textColor, font: { size: 10 } },
                            ticks: { color: textColor, font: { size: 10 } },
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });

            // 2. TOP 3 Routes Radar Chart
            const top3 = [...enriched].sort((a, b) => b.smartScore - a.smartScore).slice(0, 3);
            const palette = [
                { bg: 'rgba(99, 102, 241, 0.25)', border: 'rgb(99, 102, 241)' },
                { bg: 'rgba(16, 185, 129, 0.25)', border: 'rgb(16, 185, 129)' },
                { bg: 'rgba(245, 158, 11, 0.25)', border: 'rgb(245, 158, 11)' }
            ];

            radarChartInstance = new Chart(radarCanvas.getContext('2d'), {
                type: 'radar',
                data: {
                    labels: ['빠르기', '저렴함', '적은 환승', '쾌적함(저피로)', '짧은 도보'],
                    datasets: top3.map((r, i) => ({
                        label: r.name,
                        data: r.radarMetrics,
                        backgroundColor: palette[i].bg,
                        borderColor: palette[i].border,
                        pointBackgroundColor: palette[i].border,
                        borderWidth: 2
                    }))
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: textColor, font: { family: 'Noto Sans KR', size: 10 }, boxWidth: 12 }
                        }
                    },
                    scales: {
                        r: {
                            min: 0,
                            max: 100,
                            ticks: { display: false, stepSize: 25 },
                            grid: { color: gridColor },
                            angleLines: { color: gridColor },
                            pointLabels: {
                                color: textColor,
                                font: { family: 'Noto Sans KR', size: 11, weight: 'bold' }
                            }
                        }
                    }
                }
            });
        }

        function selectFatigueLevel(level) {
            document.getElementById('inputFatigue').value = level;
            const meta = FATIGUE_META[level] || FATIGUE_META[2];
            document.getElementById('fatigueLevelDesc').textContent = meta.desc;

            document.querySelectorAll('.fatigue-btn').forEach(btn => {
                const lv = parseInt(btn.getAttribute('data-fatigue'), 10);
                if (lv === level) {
                    btn.className = 'fatigue-btn p-2 rounded-xl border-2 border-indigo-600 dark:border-indigo-400 bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 text-center transition flex flex-col items-center space-y-0.5 shadow-2xs';
                } else {
                    btn.className = 'fatigue-btn p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 text-center transition flex flex-col items-center space-y-0.5';
                }
            });
        }

        function setCostValue(val) {
            const inputCost = document.getElementById('inputOneWayCost');
            inputCost.value = val;
            hideInputError('cost');
        }

        // 7단계: 기존 경로 수정 모드 진입
        function startEditRoute(id) {
            const target = routes.find(r => r.id === id);
            if (!target) return;

            editingRouteId = id;
            document.getElementById('formHeaderTitle').textContent = '통학 방법 수정';
            document.getElementById('formHeaderSubtitle').textContent = `"${target.name}"의 정보를 수정합니다.`;
            document.getElementById('btnSubmitText').textContent = '수정 완료하기';
            document.getElementById('btnSubmitIcon').className = 'fa-solid fa-check';
            document.getElementById('navAddLabel').textContent = '방법 수정';
            document.getElementById('btnCancelEdit').classList.remove('hidden');

            document.getElementById('inputRouteName').value = target.name;
            document.getElementById('inputOneWayMinutes').value = target.oneWayMinutes;
            document.getElementById('inputWalkMinutes').value = target.walkMinutes ?? 10;
            document.getElementById('inputOneWayCost').value = target.oneWayCost;
            document.getElementById('inputTransfers').value = target.transfers;

            const radio = document.querySelector(`input[name="transitType"][value="${target.type}"]`);
            if (radio) radio.checked = true;

            selectFatigueLevel(target.fatigue || 2);

            hideInputError('name');
            hideInputError('time');
            hideInputError('walk');
            hideInputError('cost');

            switchTab('add');
        }

        function cancelEditRoute(goHome = true) {
            editingRouteId = null;
            document.getElementById('formHeaderTitle').textContent = '새 통학 방법 추가';
            document.getElementById('formHeaderSubtitle').textContent = '비교할 통학 수단 및 피로도·도보 정보를 입력하세요.';
            document.getElementById('btnSubmitText').textContent = '통학 방법에 추가하기';
            document.getElementById('btnSubmitIcon').className = 'fa-solid fa-plus';
            document.getElementById('navAddLabel').textContent = '방법 추가';
            document.getElementById('btnCancelEdit').classList.add('hidden');

            document.getElementById('inputRouteName').value = '';
            document.getElementById('inputOneWayMinutes').value = '';
            document.getElementById('inputWalkMinutes').value = '10';
            document.getElementById('inputOneWayCost').value = '';
            document.getElementById('inputTransfers').value = '0';
            selectFatigueLevel(2);

            if (goHome) {
                switchTab('comparison');
            }
        }

        function hideInputError(type) {
            if (type === 'name') {
                document.getElementById('nameErrorMsg')?.classList.add('hidden');
                document.getElementById('inputRouteName')?.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
            } else if (type === 'time') {
                document.getElementById('timeErrorMsg')?.classList.add('hidden');
                document.getElementById('inputOneWayMinutes')?.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
            } else if (type === 'walk') {
                document.getElementById('walkErrorMsg')?.classList.add('hidden');
                document.getElementById('inputWalkMinutes')?.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
            } else if (type === 'cost') {
                document.getElementById('costErrorMsg')?.classList.add('hidden');
                document.getElementById('inputOneWayCost')?.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
            }
        }

        function showInputError(type, msg) {
            const map = {
                name: { err: 'nameErrorMsg', input: 'inputRouteName' },
                time: { err: 'timeErrorMsg', input: 'inputOneWayMinutes' },
                walk: { err: 'walkErrorMsg', input: 'inputWalkMinutes' },
                cost: { err: 'costErrorMsg', input: 'inputOneWayCost' }
            };
            const target = map[type];
            if (!target) return;
            const el = document.getElementById(target.err);
            if (el) {
                if (msg) el.querySelector('span').textContent = msg;
                el.classList.remove('hidden');
            }
            const input = document.getElementById(target.input);
            input?.classList.add('border-rose-400', 'ring-2', 'ring-rose-200');
            input?.focus();
        }

        function handleSaveRoute() {
            hideInputError('name');
            hideInputError('time');
            hideInputError('walk');
            hideInputError('cost');

            const nameInput = document.getElementById('inputRouteName');
            const timeInput = document.getElementById('inputOneWayMinutes');
            const walkInput = document.getElementById('inputWalkMinutes');
            const costInput = document.getElementById('inputOneWayCost');
            const transfersInput = document.getElementById('inputTransfers');
            const fatigueInput = document.getElementById('inputFatigue');
            const typeRadio = document.querySelector('input[name="transitType"]:checked');

            const name = nameInput.value.trim();
            const rawTime = timeInput.value.trim();
            const rawWalk = walkInput.value.trim();
            const rawCost = costInput.value.trim();
            const transfers = parseInt(transfersInput.value, 10) || 0;
            const fatigue = parseInt(fatigueInput.value, 10) || 2;
            const type = typeRadio ? typeRadio.value : 'BUS';

            if (!name) {
                showInputError('name', '통학 방법 이름을 입력해 주세요 (공백 불가).');
                return;
            }

            const time = parseInt(rawTime, 10);
            if (rawTime === '' || isNaN(time) || time <= 0) {
                showInputError('time', '1분 이상의 올바른 편도 시간을 입력해 주세요.');
                return;
            }

            const walkMinutes = parseInt(rawWalk, 10);
            if (rawWalk === '' || isNaN(walkMinutes) || walkMinutes < 0) {
                showInputError('walk', '0분 이상의 올바른 도보 시간을 입력해 주세요.');
                return;
            }

            const cost = parseInt(rawCost, 10);
            if (rawCost === '' || isNaN(cost) || cost < 0) {
                showInputError('cost', '0원 이상의 올바른 금액을 입력해 주세요.');
                return;
            }

            if (editingRouteId) {
                // Update existing route
                routes = routes.map(r => r.id === editingRouteId ? {
                    ...r,
                    name,
                    type,
                    oneWayMinutes: time,
                    walkMinutes,
                    oneWayCost: cost,
                    transfers: Math.max(0, transfers),
                    fatigue
                } : r);
                saveRoutesToStorage();
                cancelEditRoute(false);
                updateUI();
                showToast('통학 방법 정보가 수정되었습니다.');
                switchTab('comparison');
            } else {
                // Add new route
                const newRoute = {
                    id: 'route_' + Date.now(),
                    name,
                    type,
                    oneWayMinutes: time,
                    walkMinutes,
                    oneWayCost: cost,
                    transfers: Math.max(0, transfers),
                    fatigue
                };
                routes.unshift(newRoute);
                saveRoutesToStorage();
                cancelEditRoute(false);
                updateUI();
                showToast('새로운 통학 방법이 안전하게 추가되었습니다.');
                switchTab('comparison');
            }
        }

        function openDataModal() {
            document.getElementById('importErrorMsg').classList.add('hidden');
            document.getElementById('dataModal').classList.remove('hidden');
        }

        function closeDataModal() {
            document.getElementById('dataModal').classList.add('hidden');
        }

        function copyTextToClipboard(text, successMsg) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            try {
                document.execCommand('copy');
                showToast(successMsg);
            } catch (err) {
                showToast('복사에 실패했습니다.', true);
            }
            document.body.removeChild(tempInput);
        }

        function exportRoutesJson() {
            const jsonStr = JSON.stringify(routes, null, 2);
            copyTextToClipboard(jsonStr, '백업용 JSON 데이터가 클립보드에 복사되었습니다!');
        }

        function exportRoutesSummaryText() {
            const enriched = computeEnrichedRoutes();
            if (enriched.length === 0) {
                showToast('공유할 통학 경로 데이터가 없습니다.', true);
                return;
            }
            const lines = [
                `[통학 방법 비교기 Pro - 월 ${schoolDays}일 등교 기준]`,
                ...enriched.map((r, i) =>
                    `${i + 1}. ${r.name} | 편도 ${r.oneWayMinutes}분(도보 ${r.walkMinutes}분) | 월 실교통비 ${r.costInfo.finalCost.toLocaleString()}원 | 피로도 Lv.${r.effectiveFatigue} | 추천 ${r.smartScore}점`
                )
            ];
            copyTextToClipboard(lines.join('\n'), '통학 비교 요약 텍스트가 클립보드에 복사되었습니다!');
        }

        function importRoutesJson() {
            const raw = document.getElementById('importJsonTextarea').value.trim();
            const errEl = document.getElementById('importErrorMsg');
            errEl.classList.add('hidden');

            if (!raw) {
                errEl.textContent = '붙여넣은 JSON 데이터가 비어 있습니다.';
                errEl.classList.remove('hidden');
                return;
            }

            try {
                const parsed = JSON.parse(raw);
                if (!Array.isArray(parsed) || parsed.length === 0) {
                    throw new Error('유효한 배열 형식이 아닙니다.');
                }

                const validated = parsed.map((item, idx) => {
                    if (!item.name || typeof item.oneWayMinutes !== 'number' || typeof item.oneWayCost !== 'number') {
                        throw new Error(`${idx + 1}번째 항목의 필수 속성(name, oneWayMinutes, oneWayCost)이 누락되었습니다.`);
                    }
                    return {
                        id: item.id || ('route_imp_' + Date.now() + '_' + idx),
                        name: String(item.name),
                        type: ['BUS', 'SUBWAY', 'MIX', 'OTHER'].includes(item.type) ? item.type : 'BUS',
                        oneWayMinutes: Math.max(1, parseInt(item.oneWayMinutes, 10)),
                        oneWayCost: Math.max(0, parseInt(item.oneWayCost, 10)),
                        transfers: Math.max(0, parseInt(item.transfers || 0, 10)),
                        walkMinutes: Math.max(0, parseInt(item.walkMinutes ?? 10, 10)),
                        fatigue: Math.min(5, Math.max(1, parseInt(item.fatigue || 2, 10)))
                    };
                });

                routes = validated;
                saveRoutesToStorage();
                updateUI();
                document.getElementById('importJsonTextarea').value = '';
                closeDataModal();
                showToast(`총 ${validated.length}개의 통학 경로를 성공적으로 불러왔습니다!`);
            } catch (err) {
                errEl.textContent = '올바른 JSON 형식이 아닙니다: ' + err.message;
                errEl.classList.remove('hidden');
            }
        }

        function promptDeleteRoute(id, name) {
            pendingDeleteId = id;
            document.getElementById('deleteModalTargetDesc').textContent = `"${name}"`;
            document.getElementById('deleteModal').classList.remove('hidden');

            document.getElementById('btnConfirmDelete').onclick = () => {
                executeDeleteRoute(pendingDeleteId);
                closeDeleteModal();
            };
        }

        function closeDeleteModal() {
            pendingDeleteId = null;
            document.getElementById('deleteModal').classList.add('hidden');
        }

        function executeDeleteRoute(id) {
            routes = routes.filter(r => r.id !== id);
            if (editingRouteId === id) {
                cancelEditRoute(false);
            }
            saveRoutesToStorage();
            updateUI();
            showToast('통학 방법이 삭제되었습니다.');
        }

        let toastTimer;
        function showToast(message, isWarning = false) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = message;

            if (isWarning) {
                toastIcon.className = 'fa-solid fa-circle-exclamation text-amber-400 mr-2 text-sm shrink-0';
            } else {
                toastIcon.className = 'fa-solid fa-circle-check text-emerald-400 dark:text-emerald-600 mr-2 text-sm shrink-0';
            }

            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');

            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        window.onload = function() {
            initApp();

            document.getElementById('inputRouteName')?.addEventListener('input', () => hideInputError('name'));
            document.getElementById('inputOneWayMinutes')?.addEventListener('input', () => hideInputError('time'));
            document.getElementById('inputWalkMinutes')?.addEventListener('input', () => hideInputError('walk'));
            document.getElementById('inputOneWayCost')?.addEventListener('input', () => hideInputError('cost'));
        };
    </script>
</body>
