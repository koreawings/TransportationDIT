            3: { emoji: '😐', label: '약간혼잡', desc: 'Lv.3 약간혼잡 (어깨 닿음)', badgeClass: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' },
            4: { emoji: '😫', label: '혼잡', desc: 'Lv.4 혼잡 (출퇴근 만원)', badgeClass: 'bg-orange-100 text-orange-800 dark:bg-orange-950 dark:text-orange-300' },
