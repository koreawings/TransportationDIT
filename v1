            document.getElementById('activePreferenceSummary').textContent =
                `${personaNames[personaMode]} · ${isRainy ? '비/눈 ☔ (도보·자전거 감점)' : '맑음 ☀️'}`;

            document.querySelectorAll('.persona-btn').forEach(btn => {
                const p = btn.getAttribute('data-persona');
                if (p === personaMode) {
                    btn.className = 'persona-btn p-2 rounded-xl border-2 border-indigo-600 dark:border-indigo-400 bg-indigo-50/70 dark:bg-indigo-950/60 text-left transition flex flex-col justify-between shadow-2xs';
                } else {
                    btn.className = 'persona-btn p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 text-left transition flex flex-col justify-between';
                }
            });

            // Update Pass Buttons & Hint
            const trips = schoolDays * 2;
            const passHint = document.getElementById('passStatusHint');
            if (passType === 'NONE') {
                passHint.textContent = `월 총 ${trips}회 탑승 (일반 요금)`;
            } else if (passType === 'KPASS') {
                passHint.textContent = trips >= 15
                    ? `월 ${trips}회 탑승 (15회↑ 30% 환급 적용 중)`
                    : `월 ${trips}회 탑승 (15회 미만으로 환급 미적용)`;
            } else if (passType === 'CLIMATE') {
                passHint.textContent = '시내버스·지하철 월 55,000원 상한 적용';
            }

            document.querySelectorAll('.pass-btn').forEach(btn => {
                const p = btn.getAttribute('data-pass');
                if (p === passType) {
                    btn.className = 'pass-btn py-2 px-2 rounded-xl border-2 border-indigo-600 dark:border-indigo-400 bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 text-center transition flex flex-col items-center justify-center shadow-2xs';
                } else {
                    btn.className = 'pass-btn py-2 px-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 text-center transition flex flex-col items-center justify-center';
                }
            });

            const enriched = computeEnrichedRoutes();
            document.getElementById('routeCountBadge').textContent = `${enriched.length}개`;

            if (enriched.length === 0) {
                document.getElementById('bestTimeName').textContent = '데이터 없음';
                document.getElementById('bestTimeVal').textContent = '-';
                document.getElementById('bestCostName').textContent = '데이터 없음';
                document.getElementById('bestCostVal').textContent = '-';
            } else {
                const fastest = [...enriched].sort((a, b) => a.oneWayMinutes - b.oneWayMinutes)[0];
                document.getElementById('bestTimeName').textContent = fastest.name;
                document.getElementById('bestTimeVal').textContent = `편도 ${fastest.oneWayMinutes}분`;

                const cheapest = [...enriched].sort((a, b) => a.costInfo.finalCost - b.costInfo.finalCost)[0];
                document.getElementById('bestCostName').textContent = cheapest.name;
                document.getElementById('bestCostVal').textContent = `${cheapest.costInfo.finalCost.toLocaleString()}원`;
            }

            renderRouteList();
            renderAnalyticsView();
            if (!document.getElementById('viewAnalytics').classList.contains('hidden')) {
                renderAnalyticsCharts();
            }
        }

        function renderRouteList() {
            const container = document.getElementById('routeListContainer');
            const emptyState = document.getElementById('emptyRoutesState');
            container.innerHTML = '';

            const enriched = computeEnrichedRoutes();

            if (enriched.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            const fastestId = [...enriched].sort((a, b) => a.oneWayMinutes - b.oneWayMinutes)[0]?.id;
            const cheapestId = [...enriched].sort((a, b) => a.costInfo.finalCost - b.costInfo.finalCost)[0]?.id;
            const bestScoreId = [...enriched].sort((a, b) => b.smartScore - a.smartScore)[0]?.id;

            const sorted = [...enriched].sort((a, b) => {
                if (currentSort === 'SCORE') {
                    return b.smartScore - a.smartScore;
                } else if (currentSort === 'TIME') {
                    return a.oneWayMinutes - b.oneWayMinutes;
                } else if (currentSort === 'COST') {
                    return a.costInfo.finalCost - b.costInfo.finalCost;
                } else if (currentSort === 'FATIGUE') {
                    if (a.effectiveFatigue !== b.effectiveFatigue) {
                        return a.effectiveFatigue - b.effectiveFatigue;
                    }
                    return a.walkMinutes - b.walkMinutes;
                } else if (currentSort === 'TRANSFERS') {
                    if (a.transfers !== b.transfers) {
                        return a.transfers - b.transfers;
                    }
                    return a.oneWayMinutes - b.oneWayMinutes;
                }
                return 0;
            });

            sorted.forEach((item, index) => {
                const monthlyTotalMinutes = item.oneWayMinutes * 2 * schoolDays;
                const { rawMonthlyCost, finalCost, discountApplied, badgeNote } = item.costInfo;

                const isFastest = item.id === fastestId;
                const isCheapest = item.id === cheapestId;
                const isBestScore = item.id === bestScoreId;

