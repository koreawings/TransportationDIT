            },
            {
                id: 'route_102',
                name: '시내버스 52번 + 도보',
                type: 'BUS',
                oneWayMinutes: 52,
                oneWayCost: 1400,
                transfers: 0,
                walkMinutes: 18,
                fatigue: 2
            },
            {
                id: 'route_103',
                name: '광역급행버스(좌석)',
                type: 'BUS',
                oneWayMinutes: 30,
                oneWayCost: 2900,
                transfers: 0,
                walkMinutes: 6,
                fatigue: 1
            },
            {
                id: 'route_104',
                name: '마을버스 + 지옥철 환승',
                type: 'MIX',
                oneWayMinutes: 42,
                oneWayCost: 1500,
                transfers: 1,
                walkMinutes: 8,
                fatigue: 5
            },
            {
                id: 'route_105',
                name: '공공자전거(따릉이) + 지하철',
                type: 'OTHER',
                oneWayMinutes: 34,
                oneWayCost: 1500,
                transfers: 1,
                walkMinutes: 16,
                fatigue: 2
            }
        ];

        let routes = [];
        let schoolDays = 20;
        let passType = 'KPASS'; // 'NONE' | 'KPASS' | 'CLIMATE'
        let personaMode = 'TIME_FIRST'; // 'TIME_FIRST' | 'COST_FIRST' | 'COMFORT_FIRST'
        let isRainy = false;
        let currentSort = 'SCORE'; // 'SCORE' | 'TIME' | 'COST' | 'FATIGUE' | 'TRANSFERS'
        let editingRouteId = null;
        let pendingDeleteId = null;

        // Chart.js instances for safe destruction
        let barChartInstance = null;
        let radarChartInstance = null;

        function initApp() {
            // Restore Theme
            try {
                const savedTheme = localStorage.getItem(STORAGE_KEY_THEME);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
                updateThemeIcon();
            } catch (e) {
                console.warn('Theme load error:', e);
            }

            // Restore School Days
            try {
                const savedDays = localStorage.getItem(STORAGE_KEY_DAYS);
                if (savedDays !== null) {
                    const parsedDays = parseInt(savedDays, 10);
                    if (!isNaN(parsedDays) && parsedDays >= 1 && parsedDays <= 31) {
                        schoolDays = parsedDays;
                    }
                }
            } catch (e) {}

            // Restore Pass Type
            try {
                const savedPass = localStorage.getItem(STORAGE_KEY_PASS);
                if (['NONE', 'KPASS', 'CLIMATE'].includes(savedPass)) {
                    passType = savedPass;
                }
            } catch (e) {}

            // Restore Persona Mode
            try {
                const savedPersona = localStorage.getItem(STORAGE_KEY_PERSONA);
                if (['TIME_FIRST', 'COST_FIRST', 'COMFORT_FIRST'].includes(savedPersona)) {
                    personaMode = savedPersona;
                }
            } catch (e) {}

            // Restore Routes
            try {
                const savedRoutes = localStorage.getItem(STORAGE_KEY_ROUTES);
                if (savedRoutes !== null) {
                    const parsed = JSON.parse(savedRoutes);
                    if (Array.isArray(parsed)) {
                        routes = parsed.map(r => ({
                            ...r,
                            walkMinutes: typeof r.walkMinutes === 'number' ? r.walkMinutes : 10,
                            fatigue: typeof r.fatigue === 'number' ? r.fatigue : 2
                        }));
                    } else {
                        routes = JSON.parse(JSON.stringify(DEFAULT_ROUTES));
                    }
                } else {
                    routes = JSON.parse(JSON.stringify(DEFAULT_ROUTES));
                    saveRoutesToStorage();
                }
            } catch (e) {
                routes = JSON.parse(JSON.stringify(DEFAULT_ROUTES));
            }

            document.getElementById('displaySchoolDays').textContent = schoolDays;
            setupSortTabs();
            selectFatigueLevel(2);

            document.getElementById('btnResetDefaults').addEventListener('click', () => {
                routes = JSON.parse(JSON.stringify(DEFAULT_ROUTES));
                schoolDays = 20;
                passType = 'KPASS';
                personaMode = 'TIME_FIRST';
                isRainy = false;
                cancelEditRoute(false);
                saveAllState();
                document.getElementById('displaySchoolDays').textContent = schoolDays;
                updateUI();
                showToast('기본 가상 데이터 5건 및 초기 설정으로 복원되었습니다.');
            });

            updateUI();
        }

        function saveRoutesToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY_ROUTES, JSON.stringify(routes));
            } catch (e) {}
        }

        function saveAllState() {
            saveRoutesToStorage();
            try {
                localStorage.setItem(STORAGE_KEY_DAYS, schoolDays.toString());
                localStorage.setItem(STORAGE_KEY_PASS, passType);
                localStorage.setItem(STORAGE_KEY_PERSONA, personaMode);
            } catch (e) {}
        }

        function toggleTheme() {
            const htmlEl = document.documentElement;
            const isDark = htmlEl.classList.toggle('dark');
            try {
                localStorage.setItem(STORAGE_KEY_THEME, isDark ? 'dark' : 'light');
            } catch (e) {}
            updateThemeIcon();
            // Redraw charts with updated theme colors if analytics tab is visible
            if (!document.getElementById('viewAnalytics').classList.contains('hidden')) {
                renderAnalyticsCharts();
            }
        }

        function updateThemeIcon() {
            const icon = document.getElementById('themeIcon');
            if (!icon) return;
            const isDark = document.documentElement.classList.contains('dark');
            icon.className = isDark ? 'fa-solid fa-sun text-xs text-amber-300' : 'fa-solid fa-moon text-xs text-slate-600';
        }

        // 6단계: 교통패스 할인 계산 함수
        function calculateMonthlyCostInfo(route) {
            const tripsPerMonth = schoolDays * 2;
            const rawMonthlyCost = route.oneWayCost * tripsPerMonth;
            let finalCost = rawMonthlyCost;
            let discountApplied = false;
            let badgeNote = '';

            if (rawMonthlyCost === 0) {
                return { rawMonthlyCost: 0, finalCost: 0, discountApplied: false, badgeNote: '무료 통학' };
            }

            if (passType === 'KPASS') {
                if (tripsPerMonth >= 15) {
                    finalCost = Math.round(rawMonthlyCost * 0.7);
                    discountApplied = true;
                    badgeNote = 'K-패스 청년 30% 환급';
                } else {
                    badgeNote = '월 15회 미만 (할인 미적용)';
                }
            } else if (passType === 'CLIMATE') {
                // 광역버스(편도 2,000원 이상으로 가정)는 기후동행카드 제외
                if (route.oneWayCost >= 2000) {
                    badgeNote = '광역요금 기후동행 제외';
                } else {
                    if (rawMonthlyCost > 55000) {
                        finalCost = 55000;
                        discountApplied = true;
                        badgeNote = '기후동행 5.5만 상한 적용';
                    } else {
                        badgeNote = '5.5만 이하 (일반결제 유리)';
                    }
                }
            }

            return { rawMonthlyCost, finalCost, discountApplied, badgeNote };
        }

        // 8단계: 날씨 시뮬레이터가 반영된 실효 피로도 계산
        function getEffectiveFatigue(route) {
            let eff = route.fatigue || 2;
            const weatherPenaltyApplied = isRainy && (route.type === 'OTHER' || (route.walkMinutes || 0) >= 15);
            if (weatherPenaltyApplied) {
                eff = Math.min(5, eff + 2);
            }
            return { effectiveFatigue: eff, weatherPenaltyApplied };
        }

        // 8단계: 정규화(0~100) 및 가중치 기반 종합 추천 점수(Smart Score) 계산
        function computeEnrichedRoutes() {
            if (routes.length === 0) return [];

            const times = routes.map(r => r.oneWayMinutes);
            const minTime = Math.min(...times);
            const maxTime = Math.max(...times);

            const costInfos = routes.map(r => calculateMonthlyCostInfo(r));
            const finalCosts = costInfos.map(c => c.finalCost);
            const minCost = Math.min(...finalCosts);
            const maxCost = Math.max(...finalCosts);

            // Weights by Persona
            let wTime = 0.7, wCost = 0.1, wComfort = 0.2;
            if (personaMode === 'COST_FIRST') {
                wTime = 0.2; wCost = 0.7; wComfort = 0.1;
            } else if (personaMode === 'COMFORT_FIRST') {
                wTime = 0.2; wCost = 0.1; wComfort = 0.7;
            }

            return routes.map((r, idx) => {
                const costInfo = costInfos[idx];
                const { effectiveFatigue, weatherPenaltyApplied } = getEffectiveFatigue(r);

                // Normalize Time Score (40 ~ 100)
                const timeScore = maxTime === minTime
                    ? 100
                    : 100 - ((r.oneWayMinutes - minTime) / (maxTime - minTime)) * 60;

                // Normalize Cost Score (40 ~ 100)
                const costScore = maxCost === minCost
                    ? 100
                    : 100 - ((costInfo.finalCost - minCost) / (maxCost - minCost)) * 60;

                // Normalize Comfort Score (Fatigue 1~5 + Transfers + Walk time)
                const fatigueBase = 100 - ((effectiveFatigue - 1) / 4) * 65; // 100 down to 35
                const transferDeduct = Math.min(25, r.transfers * 10);
                const walkDeduct = Math.min(15, Math.max(0, (r.walkMinutes - 10) * 0.8));
                const comfortScore = Math.max(10, fatigueBase - transferDeduct - walkDeduct);

                let rawSmartScore = (timeScore * wTime) + (costScore * wCost) + (comfortScore * wComfort);

                // 비/눈 오는 날 자전거 또는 도보 15분 이상 경로 추가 감점
                if (weatherPenaltyApplied) {
                    rawSmartScore -= (r.type === 'OTHER' ? 22 : 14);
                }

                const smartScore = Math.max(5, Math.min(100, Math.round(rawSmartScore)));

                // Radar chart 5 metrics (0 ~ 100)
                const radarSpeed = Math.round(timeScore);
                const radarCheap = Math.round(costScore);
                const radarTransfer = Math.max(20, 100 - r.transfers * 25);
                const radarComfort = Math.round(100 - ((effectiveFatigue - 1) / 4) * 80);
                const radarWalk = Math.max(20, Math.round(100 - Math.min(40, r.walkMinutes) * 2));

                return {
                    ...r,
                    costInfo,
                    effectiveFatigue,
                    weatherPenaltyApplied,
                    smartScore,
                    radarMetrics: [radarSpeed, radarCheap, radarTransfer, radarComfort, radarWalk]
                };
            });
        }

        function togglePreferenceAccordion() {
            const body = document.getElementById('preferenceAccordionBody');
