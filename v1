        function switchTab(target) {
            const viewComparison = document.getElementById('viewComparison');
            const viewAddRoute = document.getElementById('viewAddRoute');
            const viewAnalytics = document.getElementById('viewAnalytics');
            const navComparison = document.getElementById('navComparison');
            const navAdd = document.getElementById('navAdd');
            const navAnalytics = document.getElementById('navAnalytics');

            viewComparison.classList.add('hidden');
            viewAddRoute.classList.add('hidden');
            viewAnalytics.classList.add('hidden');

            const resetTab = (btn) => {
                btn.className = 'flex flex-col items-center text-slate-400 dark:text-slate-500 hover:text-slate-600 transition group py-1';
                btn.querySelector('span').className = 'text-[11px] font-medium';
            };
            const setActiveTab = (btn) => {
                btn.className = 'flex flex-col items-center text-indigo-600 dark:text-indigo-400 transition group py-1';
                btn.querySelector('span').className = 'text-[11px] font-bold';
            };

            resetTab(navComparison);
            resetTab(navAdd);
            resetTab(navAnalytics);

            if (target === 'comparison') {
                viewComparison.classList.remove('hidden');
                setActiveTab(navComparison);
            } else if (target === 'add') {
                viewAddRoute.classList.remove('hidden');
                setActiveTab(navAdd);
            } else if (target === 'analytics') {
                viewAnalytics.classList.remove('hidden');
                setActiveTab(navAnalytics);
                renderAnalyticsView();
                // Ensure canvas dimensions are ready before rendering Chart.js
                setTimeout(() => renderAnalyticsCharts(), 30);
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function setupSortTabs() {
            const sortTabs = document.querySelectorAll('.sort-tab');
            sortTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    currentSort = tab.getAttribute('data-sort');
                    sortTabs.forEach(t => {
                        t.classList.remove('bg-white', 'dark:bg-slate-700', 'text-indigo-600', 'dark:text-indigo-300', 'shadow-xs', 'font-bold');
                        t.classList.add('text-slate-600', 'dark:text-slate-400');
                    });
                    tab.classList.add('bg-white', 'dark:bg-slate-700', 'text-indigo-600', 'dark:text-indigo-300', 'shadow-xs', 'font-bold');
                    tab.classList.remove('text-slate-600', 'dark:text-slate-400');
                    renderRouteList();
                });
            });
        }

        function formatMinutes(totalMinutes) {
            if (totalMinutes < 60) {
                return `${totalMinutes}분`;
            }
            const hours = Math.floor(totalMinutes / 60);
            const remainingMinutes = totalMinutes % 60;
            return remainingMinutes > 0 ? `${hours}시간 ${remainingMinutes}분` : `${hours}시간`;
        }

        function updateUI() {
            // Update Persona Buttons
            const personaNames = {
                'TIME_FIRST': '프로 지각러 모드',
                'COST_FIRST': '짠테크 모드',
                'COMFORT_FIRST': '체력 보존 모드'
