                let iconBg = 'bg-blue-100 text-blue-600 dark:bg-blue-950 dark:text-blue-300';
                if (item.type === 'SUBWAY') {
                    iconClass = 'fa-train-subway';
                    iconBg = 'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300';
                } else if (item.type === 'MIX') {
                    iconClass = 'fa-shuffle';
                    iconBg = 'bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300';
                } else if (item.type === 'OTHER') {
                    iconClass = 'fa-bicycle';
                    iconBg = 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300';
                }

                const fMeta = FATIGUE_META[item.effectiveFatigue] || FATIGUE_META[2];

                const card = document.createElement('div');
                card.className = 'bg-white dark:bg-slate-800 rounded-2xl border border-slate-200/90 dark:border-slate-700/80 p-3.5 sm:p-4 shadow-xs hover:border-indigo-300 dark:hover:border-indigo-600 transition space-y-3';

                card.innerHTML = `
                    <!-- Card Header: Rank, Type Icon, Name, Smart Score, and Edit/Delete Buttons -->
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-start space-x-2.5 min-w-0 flex-1">
